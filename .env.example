PORT=3000
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/backend_internship
# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me
# Token lifetime: seconds (3600) or a number with s/m/h/d (15m, 1h, 1d).
JWT_EXPIRES_IN=1h
